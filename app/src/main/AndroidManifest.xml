<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Winlator draws with OpenGL ES and Vulkan. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Blizzard's installer (downloaded from Blizzard), and Battle.net and the game themselves. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Winlator: the game keeps running with the screen of another app in front, sound, rumble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_wowforever"
        android:roundIcon="@mipmap/ic_wowforever_round"
        android:theme="@style/WfTheme"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:isGame="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Winlator: its game screen (its X server, with Wine and Box64 behind it), the screens its code refers to,
             and the service that keeps the game alive in the background. -->
        <activity
            android:name="com.winlator.XServerDisplayActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.winlator.ControlsEditorActivity"
            android:exported="false"
            android:theme="@style/AppThemeFullscreenDark"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name="com.winlator.ExternalControllerBindingsActivity"
            android:exported="false"
            android:theme="@style/AppThemeDark"
            android:screenOrientation="sensor" />
        <activity
            android:name="com.winlator.MainActivity"
            android:exported="false"
            android:theme="@style/AppThemeDark"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation" />
        <service
            android:name="com.winlator.services.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.filesprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
