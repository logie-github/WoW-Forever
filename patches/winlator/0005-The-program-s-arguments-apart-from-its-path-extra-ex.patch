From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: blizz <blizz@users.noreply.github.com>
Date: Sun, 1 Nov 2026 23:04:52 +0000
Subject: [PATCH] The program's arguments apart from its path (extra exec_args)

Winlator converts exec_path to a Windows path and splits it at its last backslash, so arguments
that are paths (DevilutionX's --save-dir S:\diablo) made it look for the wrong file.
---
 app/src/main/java/com/winlator/XServerDisplayActivity.java | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/app/src/main/java/com/winlator/XServerDisplayActivity.java b/app/src/main/java/com/winlator/XServerDisplayActivity.java
index 63636b5..e5fb2c7 100644
--- a/app/src/main/java/com/winlator/XServerDisplayActivity.java
+++ b/app/src/main/java/com/winlator/XServerDisplayActivity.java
@@ -959,6 +959,11 @@ public class XServerDisplayActivity extends AppCompatActivity implements Navigat
             Intent intent = getIntent();
             if (intent.hasExtra("exec_path")) {
                 execPath = WineUtils.unixToDOSPath(intent.getStringExtra("exec_path"), container);
+                // WoW Forever app: the program's arguments apart from its path, which is converted to
+                // a Windows path and split at its last backslash (arguments with paths broke that).
+                if (intent.hasExtra("exec_args") && !intent.getStringExtra("exec_args").isEmpty()) {
+                    execArgs = " "+intent.getStringExtra("exec_args");
+                }
 
                 if (execPath.endsWith(".lnk")) {
                     cmdArgs = "\""+execPath+"\"";
